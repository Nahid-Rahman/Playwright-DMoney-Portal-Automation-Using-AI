# Copy this file to .env before running the suite
PORTAL_URL=https://dmoneyportal.roadtocareer.net
BACKEND_URL=https://dmoney.roadtocareer.net

ADMIN_EMAIL=<admin email from the assignment>
ADMIN_PASSWORD=<admin password from the assignment>
SYSTEM_EMAIL=<system email from the assignment>
SYSTEM_PASSWORD=<system password from the assignment>

# Agent password at registration, and the password it is changed to by the reset step
AGENT_PASSWORD=<choose a password>
AGENT_RESET_PASSWORD=<choose a different password>

# Header value the portal's own frontend sends on admin calls (test-data setup only)
API_SECRET_KEY=<secret key from the assignment>

# Optional: an already ACTIVE customer phone to receive the 500 Tk (default: a new one is created)
# EXISTING_CUSTOMER_PHONE=01XXXXXXXXX

# Optional: delay every browser action (ms) for the headed recording
# SLOW_MO=350
